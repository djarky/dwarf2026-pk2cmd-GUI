    def status(self, msg, details="", colour="green"):
        self.status_label.set_text("Status: " + msg)
        self.status_msg = details
        self.details_buffer.set_text(details or "(no details)")

        # Automatically scroll to the bottom of the details view so the user
        # can see the actual result, not just the pk2cmd copyright boilerplate
        end_iter = self.details_buffer.get_end_iter()
        mark = self.details_buffer.create_mark(None, end_iter, False)
        self.details_view.scroll_mark_onscreen(mark)

        if self.is_dark:
            colors = {
                "red":    {"bg": "#641e16", "fg": "#f5b7b1"},
                "green":  {"bg": "#1e4d2b", "fg": "#abebc6"},
                "yellow": {"bg": "#4d4119", "fg": "#f9e79f"}
            }
            default = {"bg": "#2c2c2c", "fg": "#cccccc"}
        else:
            colors = {
                "red":    {"bg": "#ffcccc", "fg": "#2c0b0b"},
                "green":  {"bg": "#ccffcc", "fg": "#0b2c0b"},
                "yellow": {"bg": "#ffffcc", "fg": "#2c2c0b"}
            }
            default = {"bg": "#ffffff", "fg": "#000000"}

        scheme = colors.get(colour, default)

        css = Gtk.CssProvider()
        css_data = f"""
        label {{
            background-color: {scheme['bg']};
            color: {scheme['fg']};
            padding: 5px;
        }}
        """

        css.load_from_data(css_data.encode())
        self.status_label.get_style_context().add_provider(
            css,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        # Allow hiding the pane even if details are empty
        if self.details_scroll.get_visible():
            self.status_btn.set_sensitive(True)
        else:
            self.status_btn.set_sensitive(bool(details))

    def update_active(self, reason, value):
        self.ready[reason] = value

        device_ready = self.ready["device"]
        file_ready = self.ready["file"]

        self.program_btn.set_sensitive(device_ready and file_ready)
        self.verify_btn.set_sensitive(device_ready and file_ready)
        self.read_btn.set_sensitive(device_ready)
        self.erase_btn.set_sensitive(device_ready)
        self.blank_btn.set_sensitive(device_ready)
        self.ptg_btn.set_sensitive(device_ready and file_ready)
        self.run_btn.set_sensitive(device_ready)
        self.stop_btn.set_sensitive(device_ready)


    def hex_query_tooltip_cb(self, widget, x, y, keyboard_tip, tooltip):
        """Show a floating tooltip describing the memory region under the cursor."""
        if keyboard_tip:
            return False
        # Convert widget coords to buffer coords
        bx, by = widget.window_to_buffer_coords(Gtk.TextWindowType.WIDGET, x, y)
        result = widget.get_iter_at_location(bx, by)
        # get_iter_at_location returns (bool, iter) in GTK 3.20+
        if isinstance(result, tuple):
            over_text, text_iter = result
            if not over_text:
                return False
        else:
            text_iter = result

        offset = text_iter.get_offset()
        phys_addr = self.hex_addr_map.get(offset)
        if phys_addr is None:
            return False

        region_name, _ = get_address_info(phys_addr)
        if region_name:
            tooltip.set_text(f"0x{phys_addr:06X} — {region_name}")
        else:
            tooltip.set_text(f"0x{phys_addr:06X} — Program Memory")
        return True

    def update_hex_view(self, filepath):
        if not filepath or not os.path.isfile(filepath):
            self.hex_view_buffer.set_text("No HEX file loaded.")
            self.hex_addr_map = {}
            return

        memory = parse_intel_hex(filepath)
        if not memory:
            self.hex_view_buffer.set_text("Empty or invalid HEX file.")
            self.hex_addr_map = {}
            return

        addresses = sorted(memory.keys())
        if not addresses:
            self.hex_view_buffer.set_text("No data in HEX file.")
            self.hex_addr_map = {}
            return

        min_addr = (addresses[0] // 16) * 16
        max_addr = ((addresses[-1] // 16) + 1) * 16

        self.hex_view_buffer.set_text("")
        self.hex_addr_map = {}

        addr = min_addr
        in_gap = False
        gap_start = 0

        self.hex_view.set_sensitive(False)

        while addr < max_addr:
            has_data = any((addr + i) in memory for i in range(16))

            if not has_data:
                if not in_gap:
                    in_gap = True
                    gap_start = addr
                addr += 16
                continue

            if in_gap:
                gap_len = addr - gap_start
                gap_iter = self.hex_view_buffer.get_end_iter()
                self.hex_view_buffer.insert_with_tags_by_name(
                    gap_iter,
                    f"... [GAP: {gap_len} (0x{gap_len:X}) bytes] ...\n",
                    "gap_style"
                )
                in_gap = False

            row_iter = self.hex_view_buffer.get_end_iter()
            self.hex_view_buffer.insert(row_iter, f"0x{addr:06X}:  ")

            for i in range(16):
                byte_addr = addr + i
                reg_name, tag_name = get_address_info(byte_addr)

                if byte_addr in memory:
                    text = f"{memory[byte_addr]:02X}"
                else:
                    text = ".."

                if i == 7:
                    spacing = "  "
                else:
                    spacing = " "

                # Record buffer offset -> physical address for each char of the hex pair
                cur_offset = self.hex_view_buffer.get_end_iter().get_offset()
                for ch_idx in range(len(text)):
                    self.hex_addr_map[cur_offset + ch_idx] = byte_addr

                word_iter = self.hex_view_buffer.get_end_iter()
                if tag_name:
                    self.hex_view_buffer.insert_with_tags_by_name(
                        word_iter,
                        text + spacing,
                        tag_name
                    )
                else:
                    self.hex_view_buffer.insert(word_iter, text + spacing)

            end_iter = self.hex_view_buffer.get_end_iter()
            self.hex_view_buffer.insert(end_iter, "\n")

            addr += 16

        if in_gap:
            gap_len = max_addr - gap_start
            gap_iter = self.hex_view_buffer.get_end_iter()
            self.hex_view_buffer.insert_with_tags_by_name(
                gap_iter,
                f"... [GAP: {gap_len} (0x{gap_len:X}) bytes] ...\n",
                "gap_style"
            )

        self.hex_view.set_sensitive(True)


class PicKit:

    def __init__(self, parent, verbosity=False):
        self.verbosity = verbosity
        self.cmd = PK2CMD
        self.parent = parent
        self.device = ""

    def show_install_help(self):
        """Show a dialog with instructions on how to obtain and install pk2cmd."""
        dialog = Gtk.MessageDialog(
            transient_for=self.parent,
            flags=Gtk.DialogFlags.MODAL,
            message_type=Gtk.MessageType.INFO,
            buttons=Gtk.ButtonsType.CLOSE,
            text="How to Install pk2cmd"
        )
        dialog.format_secondary_markup(
            "<b>pk2cmd</b> is a command-line tool originally developed by "
            "Microchip Technology for PICkit programmers.\n\n"
            "Dwarf requires pk2cmd to be installed and available in your "
            "system PATH.\n\n"
            "<b>Options to obtain pk2cmd:</b>\n\n"
            "  1. <b>Community builds</b> — search for pk2cmd AppImage or\n"
            "     binary builds on GitHub (e.g. jaka-fi/pk2cmd,\n"
            "     boborjan2/pk2cmd, or other forks).\n\n"
            "  2. <b>Build from source</b> — clone a pk2cmd repository\n"
            "     and compile it with <tt>make linux</tt>.\n\n"
            "  3. <b>PICkitPlus</b> — a commercial alternative at\n"
            "     <tt>www.pickitplus.co.uk</tt> with updated device\n"
            "     support.\n\n"
            "Once installed, place the <tt>pk2cmd</tt> binary in a\n"
            "directory on your PATH (e.g. <tt>~/.local/bin/</tt> or\n"
            "<tt>/usr/local/bin/</tt>), then click <b>Detect</b>."
        )
        dialog.run()
        dialog.destroy()

    def detect_programmer(self):
        """Scans for connected PICkit programmers and returns the name/type."""
        if shutil.which(self.cmd) is None:
            return "No pk2cmd"

        output = self._run_command(["-S"])

        if "No PICkit" in output or "not found" in output:
            return None

        # Parse the programmer name
        for line in output.splitlines():
            if "Unit type:" in line:
                return line.split(":", 1)[1].strip()
            if "PICkit 3" in line:
                return "PICkit 3"
            if "PICkit 2" in line:
                return "PICkit 2"
            if "PKOB" in line:
                return "PKOB"

        if "Operation Succeeded" in output:
            return "PICkit (Detected)"

        return None

    def connect(self):
        if shutil.which(self.cmd) is None:
            self.device = ""
            self.parent.programmer_name = ""
            self.parent.programmer_label.set_text("(none)")
            self.parent.model.set_text("(none)")
            self.parent.status(
                "pk2cmd not installed!",
                f"Could not find '{self.cmd}' in PATH.",
                "red"
            )
            self.parent.update_active("device", False)
            dialog = Gtk.MessageDialog(
                transient_for=self.parent,
                flags=Gtk.DialogFlags.MODAL,
                message_type=Gtk.MessageType.WARNING,
                buttons=Gtk.ButtonsType.NONE,
                text="pk2cmd Required!"
            )
            dialog.format_secondary_text(
                "The pk2cmd command line program could not be found.\n\n"
                "pk2cmd must be installed and available in your system PATH "
                "to use Dwarf. Click 'Help' for installation instructions."
            )
            dialog.add_button("Close", Gtk.ResponseType.CANCEL)
            dialog.add_button("Help", Gtk.ResponseType.ACCEPT)
            
            response = dialog.run()
            dialog.destroy()
            
            if response == Gtk.ResponseType.ACCEPT:
                self.show_install_help()
            return False

        prog_type = self.detect_programmer()
        if not prog_type:
            self.device = ""
            self.parent.programmer_name = ""
            self.parent.programmer_label.set_text("(none)")
            self.parent.model.set_text("(none)")
            self.parent.status(
                "Programmer not found",
                "Please connect a PICkit 2/3 or PKOB programmer.",
                "yellow"
            )
            self.parent.update_active("device", False)
            return False

        self.parent.programmer_name = prog_type
        self.parent.programmer_label.set_text(prog_type)

        opts = ["-P"]
        voltage_val = self.parent.get_voltage()
        if voltage_val:
            opts.append(f"-A{voltage_val}")

        if self.parent.is_target_power_on():
            opts.append("-T")

        output = self._run_command(opts)

        if "No PICkit" in output or "not found" in output:
            self.device = ""
            self.parent.model.set_text("(none)")
            self.parent.status(
                "Programmer error",
                output,
                "yellow"
            )
            self.parent.update_active("device", False)
            return False

        if "No known part found" in output or ("Device ID" in output and "not found" in output):
            self.device = ""
            self.parent.model.set_text("(none)")
            self.parent.status(
                "No PIC found",
                output + "\n\n(Ensure target board is powered or VDD is enabled)",
                "yellow"
            )
            self.parent.update_active("device", False)
            return False

        marker = "Found part "
        if marker in output:
            start = output.find(marker) + len(marker)
            end = output.find(".", start)
            if end == -1:
                device = output[start:].strip()
            else:
                device = output[start:end].strip()

            self.device = device
            self.parent.model.set_text(device)
            self.parent.status(
                f"Detected {device} ({prog_type})",
                output,
                "green"
            )
            self.parent.update_active("device", True)
            return True

        self.device = ""
        self.parent.model.set_text("(unknown)")
        self.parent.status(
            "Could not identify PIC",
            output,
            "yellow"
        )
        self.parent.update_active("device", False)
        return False

    def show_error(self, title, message):
        dialog = Gtk.MessageDialog(
            transient_for=self.parent,
            flags=Gtk.DialogFlags.MODAL,
            message_type=Gtk.MessageType.ERROR,
            buttons=Gtk.ButtonsType.CLOSE,
            text=title
        )
        dialog.format_secondary_text(message)
        dialog.run()
        dialog.destroy()

    def set_target_power(self, is_on):
        opts = []
        if self.device:
            opts.append("-P" + self.device)
            
        voltage_val = self.parent.get_voltage()
        if voltage_val:
            opts.append(f"-A{voltage_val}")
            
        if is_on:
            opts.append("-T")
            
        output = self._run_command(opts)
        
        if is_on:
            self.parent.status("Target power ON", output, "green")
        else:
            self.parent.status("Target power OFF", output, "green")

    def program(self, hexfile):
        if not self.device:
            self.parent.status("No PIC detected", "", "red")
            return

        opts = [
            "-P" + self.device,
            "-F" + hexfile,
            "-M"
        ]

        voltage_val = self.parent.get_voltage()
        if voltage_val:
            opts.append(f"-A{voltage_val}")
            
        if self.parent.is_target_power_on():
            opts.append("-T")

        output = self._run_command(opts)

        if "Program Succeeded" in output:
            self.parent.status("Program Succeeded", output, "green")
        else:
            self.parent.status("Program Failed", output, "red")

    def ptg(self, hexfile):
        if not self.device:
            self.parent.status("No PIC detected", "", "red")
            return

        opts = [
            "-P" + self.device,
            "-F" + hexfile,
            "-M",
            "-G"
        ]

        voltage_val = self.parent.get_voltage()
        if voltage_val:
            opts.append(f"-A{voltage_val}")
            
        if self.parent.is_target_power_on():
            opts.append("-T")

        output = self._run_command(opts)

        if "Program Succeeded" in output or "Operation Succeeded" in output:
            self.parent.status("PTG Setup Succeeded", output, "green")
        else:
            self.parent.status("PTG Setup Failed", output, "red")

    def verify(self, hexfile):
        if not self.device:
            self.parent.status("No PIC detected", "", "red")
            return

        opts = [
            "-P" + self.device,
            "-F" + hexfile,
            "-Y"
        ]

        voltage_val = self.parent.get_voltage()
        if voltage_val:
            opts.append(f"-A{voltage_val}")
            
        if self.parent.is_target_power_on():
            opts.append("-T")

        output = self._run_command(opts)

        if "Verify Succeeded" in output or "Operation Succeeded" in output:
            self.parent.status("Verify Succeeded", output, "green")
        else:
            self.parent.status("Verify Failed", output, "red")

    def read_device(self, hexfile):
        if not self.device:
            self.parent.status("No PIC detected", "", "red")
            return

        opts = [
            "-P" + self.device,
            "-GF" + hexfile
        ]

        voltage_val = self.parent.get_voltage()
        if voltage_val:
            opts.append(f"-A{voltage_val}")
            
        if self.parent.is_target_power_on():
            opts.append("-T")

        output = self._run_command(opts)
        self.parent.status("PIC read complete", output, "green")
        if "Operation Succeeded" in output or "Read Succeeded" in output or not output.startswith("Error"):
            self.parent.source_file = os.path.abspath(hexfile)
            self.parent.ready["file"] = True
            basename = os.path.basename(hexfile)
            self.parent.file_label.set_text(basename)
            self.parent.file_label.set_tooltip_text(self.parent.source_file)
            self.parent.set_title(f"Dwarf {VERSION}: {basename}")
            self.parent.update_active("file", True)
            self.parent.update_hex_view(hexfile)

    def erase(self):
        if not self.device:
            self.parent.status("No PIC detected", "", "red")
            return

        opts = [
            "-P" + self.device,
            "-E"
        ]

        voltage_val = self.parent.get_voltage()
        if voltage_val:
            opts.append(f"-A{voltage_val}")
            
        if self.parent.is_target_power_on():
            opts.append("-T")

        output = self._run_command(opts)

        if "Erase Succeeded" in output or "Operation Succeeded" in output:
            self.parent.status("Erase Succeeded", output, "green")
        else:
            self.parent.status("Erase Failed", output, "red")

    def blank_check(self):
        if not self.device:
            self.parent.status("No PIC detected", "", "red")
            return

        opts = [
            "-P" + self.device,
            "-C"
        ]

        voltage_val = self.parent.get_voltage()
        if voltage_val:
            opts.append(f"-A{voltage_val}")
            
        if self.parent.is_target_power_on():
            opts.append("-T")

        output = self._run_command(opts)

        if "Device is Blank" in output or "Blank Check Succeeded" in output or "Operation Succeeded" in output:
            self.parent.status("Device is Blank", output, "green")
        else:
            self.parent.status("Device is NOT Blank", output, "red")

    def run(self):
        if not self.device:
            return

        opts = [
            "-P" + self.device,
            "-R",
            "-T"
        ]

        voltage_val = self.parent.get_voltage()
        if voltage_val:
            opts.append(f"-A{voltage_val}")

        output = self._run_command(opts)
        self.parent.status("PIC running", output, "green")
        
        # Sync switch to reflect that VDD is ON
        self.parent.updating_power_switch = True
        self.parent.power_switch.set_active(True)
        self.parent.updating_power_switch = False

    def stop(self):
        if not self.device:
            return

        opts = [
            "-P" + self.device
        ]

        voltage_val = self.parent.get_voltage()
        if voltage_val:
            opts.append(f"-A{voltage_val}")

        output = self._run_command(opts)
        self.parent.status("PIC stopped", output, "green")
        
        # Sync switch to reflect that VDD is OFF
        self.parent.updating_power_switch = True
        self.parent.power_switch.set_active(False)
        self.parent.updating_power_switch = False

    def _run_command(self, args):
        command = [self.cmd] + args

        if self.verbosity:
            print("$ " + " ".join(command))

        try:
            process = Popen(
                command,
                stdout=PIPE,
                stderr=PIPE,
                text=True
            )
            stdout, stderr = process.communicate()
            output = stdout
            if stderr:
                output += stderr

            if self.verbosity:
                print(output)

            return output

        except FileNotFoundError:
            return f"Error: {self.cmd} not found."
        except Exception as exc:
            return f"Error executing {self.cmd}: {exc}"


