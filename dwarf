def parse_intel_hex(filepath):
    """Parses an Intel HEX file into a dictionary of physical_address -> byte."""
    memory = {}
    upper_address = 0
    try:
        with open(filepath, 'r') as f:
            for line in f:
                line = line.strip()
                if not line.startswith(':'):
                    continue
                try:
                    byte_count = int(line[1:3], 16)
                    addr = int(line[3:7], 16)
                    record_type = int(line[7:9], 16)
                    data_str = line[9:9+byte_count*2]
                    
                    if record_type == 0:  # Data record
                        phys_addr = (upper_address << 16) + addr
                        for i in range(byte_count):
                            val = int(data_str[i*2:(i+1)*2], 16)
                            memory[phys_addr + i] = val
                    elif record_type == 1:  # EOF
                        break
                    elif record_type == 2:  # Extended Segment Address
                        upper_address = int(data_str, 16) << 4
                    elif record_type == 4:  # Extended Linear Address
                        upper_address = int(data_str, 16)
                except ValueError:
                    continue
    except Exception as exc:
        print(f"Error parsing hex file: {exc}")
    return memory


def get_address_info(addr):
    """Maps physical byte address to name and tag style class."""
    if 0x0000 <= addr <= 0x0007:
        return "Reset Vector", "reset"
    elif 0x0008 <= addr <= 0x001F:
        return "Interrupt Vector", "interrupt"
    # PIC12/PIC16 ranges (word address * 2)
    elif 0x4000 <= addr <= 0x4007:
        return "User ID", "userid"
    elif 0x4008 <= addr <= 0x400D:
        return "Device ID", "userid"
    elif 0x400E <= addr <= 0x401F:
        return "Config Words", "config"
    elif 0x4200 <= addr <= 0x4FFF:
        return "EEPROM", "eeprom"
    # PIC18 ranges
    elif 0x200000 <= addr <= 0x20000F:
        return "User ID", "userid"
    elif 0x300000 <= addr <= 0x30000F:
        return "Config Bits", "config"
    elif 0x3FFFFE <= addr <= 0x3FFFFF:
        return "Device ID", "userid"
    elif 0xF00000 <= addr <= 0xF00FFF:
        return "EEPROM", "eeprom"
    return None, None


def detect_dark_theme():
    """Returns True if the current GTK theme appears to be dark."""
    settings = Gtk.Settings.get_default()
    if settings:
        prefer_dark = settings.get_property("gtk-application-prefer-dark-theme")
        if prefer_dark:
            return True
        theme_name = settings.get_property("gtk-theme-name") or ""
        if "dark" in theme_name.lower():
            return True
    # Fall back to sampling the default window background color
    dummy = Gtk.Window()
    style = dummy.get_style_context()
    bg = style.get_background_color(Gtk.StateFlags.NORMAL)
    dummy.destroy()
    # If luminance is low, it's a dark theme
    luminance = 0.299 * bg.red + 0.587 * bg.green + 0.114 * bg.blue
    return luminance < 0.5


