    def on_drag_data_received(self, widget, drag_context, x, y, data, info, time):
        uris = data.get_uris()
        if uris:
            for uri in uris:
                parsed = urlparse(uri)
                if parsed.scheme == 'file':
                    filepath = unquote(parsed.path)
                    if filepath.lower().endswith('.hex'):
                        self.set_file(filepath)
                        break
            Gtk.drag_finish(drag_context, True, False, time)
        else:
            Gtk.drag_finish(drag_context, False, False, time)

        # Reset visual feedback after drop
        self._reset_hex_frame_style()

    def on_hex_drag_motion(self, widget, drag_context, x, y, time):
        """Highlight the HEX viewer frame green while a file hovers over it."""
        css = Gtk.CssProvider()
        if self.is_dark:
            css_data = b"frame { border: 2px solid #58d68d; background-color: rgba(88,214,141,0.08); }"
        else:
            css_data = b"frame { border: 2px solid #27ae60; background-color: rgba(39,174,96,0.08); }"
        css.load_from_data(css_data)
        ctx = self.hex_frame.get_style_context()
        # Remove previous highlight provider if present
        if hasattr(self, '_hex_drag_css'):
            ctx.remove_provider(self._hex_drag_css)
        self._hex_drag_css = css
        ctx.add_provider(css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        return True

    def on_hex_drag_leave(self, widget, drag_context, time):
        """Remove the green highlight when the drag leaves."""
        self._reset_hex_frame_style()

    def _reset_hex_frame_style(self):
        if hasattr(self, '_hex_drag_css'):
            self.hex_frame.get_style_context().remove_provider(self._hex_drag_css)
            del self._hex_drag_css

