def main():

    try:

        optlist, args = getopt.gnu_getopt(
            sys.argv[1:],
            "vh",
            ["verbose", "help"]
        )

    except getopt.GetoptError as err:

        print(str(err))
        usage()
        sys.exit(2)

    verbosity = False

    for option, argument in optlist:

        if option in ("-h", "--help"):

            usage()
            sys.exit(0)

        elif option in ("-v", "--verbose"):

            verbosity = True

    main_win = MainWindow(
        verbosity
    )

    if len(args) >= 1:

        main_win.set_file(
            args[0]
        )

        if len(args) > 1:

            print(
                "Warning: can only select "
                "one file; first argument used."
            )

    Gtk.main()


if __name__ == "__main__":
    main()
